FROM node:16-alpine AS build

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Production stage
FROM node:16-alpine

WORKDIR /app

# Install serve to run the static files
RUN npm install -g serve

# Copy built application from build stage
COPY --from=build /app/build ./build

# Expose port
EXPOSE 3000

# Set environment variables for API URLs
ENV REACT_APP_USER_SERVICE_URL=http://user-service:5001
ENV REACT_APP_ORDER_SERVICE_URL=http://order-service:5002

# Run the application
CMD ["serve", "-s", "build", "-l", "3000"]
